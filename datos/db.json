rocesos de proteínas cárnicas: de 8 °C a 12 °C.\n• Cuarto de maduración de fruver: de 16 °C a 20 °C. Cuarto de refrigeración de fruver: de 8 °C a 14 °C.\n\nSi está fuera del rango\n➤ Si el producto está por fuera del límite permitido, reubicar los productos y solicitar la revisión de inmediato.\n➤ Si el cuarto, nevera/exhibidor o área no está en la temperatura permitida, revisar la conexión, cerrar las puertas y verificar si la temperatura se regula.\n➤ Si en 15 minutos la temperatura no se ha estabilizado, solicitar la revisión de inmediato.","vinculo":"equipo","tipoEquipo":"","horarios":["08:00","12:00","16:00","20:00"],"vecesDia":4,"preguntas":[{"id":"h1","tipo":"seccion","etiqueta":"Datos del equipo","ayuda":"","requerida":false,"opciones":[],"autollenado":"","bloqueada":false,"condicion":null,"redondear":false,"alerta":{"modo":"ninguna","min":"","max":"","rangos":{"CONGELACION":["",-18],"REFRIGERACION":[0,4],"MADURACION / CLIMATIZACION":[16,20],"PROCESOS":[8,12]},"excepciones":[{"seccion":"FRUVER","tipo":"CUARTO FRIO","subtipo":"REFRIGERACION","min":8,"max":14}],"ref":"","porOpcion":{}}},{"id":"q_sede","tipo":"texto","etiqueta":"Centro de operaciones","ayuda":"","requerida":true,"opciones":[],"autollenado":"activo.sede","bloqueada":true,"condicion":null,"redondear":false,"alerta":{"modo":"ninguna","min":"","max":"","rangos":{"CONGELACION":["",-18],"REFRIGERACION":[0,4],"MADURACION / CLIMATIZACION":[16,20],"PROCESOS":[8,12]},"excepciones":[{"seccion":"FRUVER","tipo":"CUARTO FRIO","subtipo":"REFRIGERACION","min":8,"max":14}],"ref":"","porOpcion":{}}},{"id":"q_secc","tipo":"texto","etiqueta":"Sección","ayuda":"","requerida":true,"opciones":[],"autollenado":"activo.seccion","bloqueada":true,"condicion":null,"redondear":false,"alerta":{"modo":"ninguna","min":"","max":"","rangos":{"CONGELACION":["",-18],"REFRIGERACION":[0,4],"MADURACION / CLIMATIZACION":[16,20],"PROCESOS":[8,12]},"excepciones":[{"seccion":"FRUVER","tipo":"CUARTO FRIO","subtipo":"REFRIGERACION","min":